PORT=5000
NODE_ENV=development

# Database & Auth
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""

# Alpaca Market Data (optional live stream test)
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_DATA_FEED=iex

# Simulated Market Data Engine
MARKET_DATA_PROVIDER=simulated
SIMULATION_INTERVAL_MS=2500
SIMULATION_PERSIST_INTERVAL_MS=30000
SIMULATION_HISTORY_LIMIT=500
